[Unit]
Description=Cover Forge API (background removal + PDF export)
After=network.target

[Service]
Type=simple
# Adjust User/Group to match your host (the owner runs services under a dedicated user).
User=www-data
Group=www-data
WorkingDirectory=/opt/cover-forge/server
Environment=CF_PORT=5004
# Set this to the real frontend origin in production (NOT * ):
Environment=CF_ALLOWED_ORIGIN=https://coverforge.example.lan
Environment=CF_MAX_UPLOAD_MB=25
ExecStart=/opt/cover-forge/.venv/bin/gunicorn -w 2 -b 127.0.0.1:5004 --timeout 120 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
